# ─────────── Banco de dados (Postgres) ───────────
# Credenciais usadas pelo docker-compose para subir o Postgres local.
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
# Porta exposta no host (a 5432 já é usada por outro container na máquina).
POSTGRES_PORT=5433

# String de conexão usada pela API rodando fora do Docker (npm run start:dev).
DATABASE_URL="postgresql://oficina:oficina@localhost:5433/oficina?schema=public"

# ─────────── Aplicação ───────────
PORT=3000
APP_PORT=3000
NODE_ENV=development

# ─────────── JWT (rotas administrativas) ───────────
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="3600s"

# ─────────── Seed ───────────
# Senha do usuário gestor criado pelo seed (obrigatória; no cluster vem do secret GESTOR_SENHA).
SEED_GESTOR_SENHA="gestor123"

# ─────────── New Relic (opcional) ───────────
# License key do tipo INGEST - LICENSE (40 caracteres, termina em NRAL).
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
# Simula a queda do serviço de notificações (painel de erros e alerta).
SIMULAR_FALHA_NOTIFICACAO=false
